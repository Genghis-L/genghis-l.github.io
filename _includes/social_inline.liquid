<div class="social-inline">
  <div class="contact-icons-inline">
    {% for social in site.data.socials %}
      {% case social[0] %}
        {% when 'email' %}
          <a href="mailto:{{ social[1] | encode_email }}" title="email" aria-label="email">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          </a>
        {% when 'github_username' %}
          <a href="https://github.com/{{ social[1] }}" title="GitHub" aria-label="GitHub">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
          </a>
        {% when 'linkedin_username' %}
          <a href="https://www.linkedin.com/in/{{ social[1] }}" title="LinkedIn" aria-label="LinkedIn">
            <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
          </a>
        {% when 'kaggle_id' %}
          <a href="https://www.kaggle.com/{{ social[1] }}" title="Kaggle" aria-label="Kaggle">
            <i class="fa-brands fa-kaggle" aria-hidden="true"></i>
          </a>
        {% when 'youtube_id' %}
          <a href="https://youtube.com/@{{ social[1] }}" title="YouTube" aria-label="YouTube">
            <i class="fa-brands fa-youtube" aria-hidden="true"></i>
          </a>
        {% when 'scholar_userid' %}
          <a href="https://scholar.google.com/citations?user={{ social[1] }}" title="Google Scholar" aria-label="Google Scholar">
            <i class="ai ai-google-scholar" aria-hidden="true"></i>
          </a>
      {% endcase %}
    {% endfor %}
  </div>
</div>

<style>
  .social-inline {
    margin-top: 10px;
    margin-bottom: 15px;
    text-align: left;
  }
  .contact-icons-inline {
    display: inline-flex;
    gap: 12px;
  }
  .contact-icons-inline a {
    font-size: 3rem;
    color: var(--global-text-color);
  }
  .contact-icons-inline a:hover {
    color: var(--global-theme-color);
  }
</style>
