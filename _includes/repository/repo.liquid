{% assign repo_name = include.repository | split: '/' | last %}
{% assign card = site.data.repository_cards.repositories[include.repository] %}
<div class="repo repo-local p-2">
  <a class="repo-card" href="https://github.com/{{ include.repository }}">
    <span class="repo-card-title"><i class="fa-solid fa-book-bookmark" aria-hidden="true"></i> {{ repo_name | escape }}</span>
    <span class="repo-card-owner">{{ include.repository | escape }}</span>
    <span class="repo-card-description">{{ card.description | default: 'Explore this repository on GitHub.' | escape }}</span>
    {% if card %}
      <span class="repo-card-metrics">
        <span>{{ card.language | escape }}</span>
        <span><i class="fa-regular fa-star" aria-hidden="true"></i> Stars: {{ card.stars }}</span>
        <span><i class="fa-solid fa-code-fork" aria-hidden="true"></i> Forks: {{ card.forks }}</span>
      </span>
      <span class="repo-card-updated">GitHub snapshot · {{ site.data.repository_cards.checked_on | escape }}</span>
    {% endif %}
  </a>
</div>
