<div class="repo repo-local p-2">
  <a class="repo-card repo-profile-card" href="https://github.com/{{ include.username }}">
    <span class="repo-card-title"><i class="fa-brands fa-github" aria-hidden="true"></i> {{ include.username | escape }}</span>
    <span class="repo-card-owner">GitHub profile</span>
    <span class="repo-card-description">Explore my code, contributions, and public repositories on GitHub.</span>
    <span class="repo-card-metrics">{{ site.data.repositories.github_repos.size }} featured repositories below</span>
    <span class="repo-card-action">View profile <span aria-hidden="true">↗</span></span>
  </a>
</div>
