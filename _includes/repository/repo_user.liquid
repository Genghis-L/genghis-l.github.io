<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}">
    <img
      onerror="this.hidden = true;"
      class="only-light w-100"
      alt="{{ include.username }}"
      src="https://github-readme-stats.vercel.app/api/?username={{ include.username }}&theme={{ site.repo_theme_light }}&show_icons=true&rank_icon=github&hide=stars,prs&show=prs_merged,reviews"
    >
    <img
      onerror="this.hidden = true;"
      class="only-dark w-100"
      alt="{{ include.username }}"
      src="https://github-readme-stats.vercel.app/api/?username={{ include.username }}&theme={{ site.repo_theme_dark }}&show_icons=true&rank_icon=github&hide=stars,prs&show=prs_merged,reviews"
    >
    <span class="d-block">{{ include.username }} on GitHub</span>
  </a>
</div>
